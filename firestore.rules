rules_version = '2';

// Vayun team data. Who may do what:
//   - Anyone signed in can create a team (and becomes its owner and first admin) and look up one invite
//     code they know.
//   - Only members can read a team, its tasks and its events.
//   - Roles: admin (everything), lead (gives tasks and team events, edits the ones they made), member
//     (changes only the status of the tasks given to them).
//   - Only admins change roles, remove people, rename the team or make a new invite code. The owner (the
//     person who created the team) is always an admin and can never be removed.
//   - Someone with the invite code can add themselves to a team as a member; anyone but the owner can leave.
//   - Nothing is ever really deleted from tasks or events (they are marked deleted), so everyone's app can
//     notice the change.
// app/team-logic.js has the same rules in code (checkTaskPatch and friends); change both together.
//
// Superadmin ("God Mode"): a short, fixed allowlist of operator emails (see isSuperAdmin() below) that sits
// above the whole team hierarchy. A superadmin bypasses every team-membership check below and can read/write
// any team, task, event or invite in the system, plus the public release ledger, plus any document at any
// path at all (the catch-all at the bottom, for the website's Universal Raw Entity Editor). This is the one
// place the normal "nothing is really deleted" and "only members" guarantees are intentionally overridable —
// treat changes to isSuperAdmin() as seriously as changes to the role logic above it.
//
// Release Admin: a narrower allowlist (see isReleaseAdmin()) for people who manage the public release ledger
// (vayun-workspace's /admin page) but must NOT get superadmin's reach into team data. Every superadmin is
// automatically a release admin too.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Superadmin / Release Admin allowlists. Keep this in sync with VITE_SUPERADMIN_EMAILS /
    // VITE_ADMIN_EMAILS in vayun-workspace/.env.local — if they drift, the website's superadmin UI will
    // let someone in but every Firestore call will fail.
    function isSuperAdmin() {
      return signedIn() && (
        request.auth.token.superadmin == true ||
        (request.auth.token.email != null && request.auth.token.email.lower() in ['mukulsharmaworks@gmail.com'])
      );
    }

    function isReleaseAdmin() {
      return isSuperAdmin() || (
        signedIn() && (
          request.auth.token.admin == true ||
          (request.auth.token.email != null && request.auth.token.email.lower() in ['mukulsharmaworks@gmail.com'])
        )
      );
    }

    // A person's entry in a team: only strings, and not absurdly long.
    function sane(person) {
      return person.name is string && person.name.size() <= 100
        && person.email is string && person.email.size() <= 200
        && person.photoURL is string && person.photoURL.size() <= 1000;
    }

    // An invite code points at a team. You can look up a code you know, but nobody can list them (except a
    // superadmin, who can see every invite code in the system from the website's Invites tab). Only an admin
    // of the team — or a superadmin — makes or removes its codes.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly(['teamId', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.members[request.auth.uid].role == 'admin'
        && getAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.inviteCode == code);
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin() || (signedIn()
        && get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.members[request.auth.uid].role == 'admin');
    }

    match /teams/{teamId} {
      function before() { return resource.data; }
      function after() { return request.resource.data; }
      function isMemberOf(team) { return signedIn() && request.auth.uid in team.memberIds; }
      function isAdminOf(team) { return isMemberOf(team) && team.members[request.auth.uid].role == 'admin'; }
      function changedKeys() { return after().diff(before()).affectedKeys(); }

      allow read: if isSuperAdmin() || isMemberOf(resource.data);

      allow create: if isSuperAdmin() || (signedIn()
        && after().keys().hasOnly(['name', 'ownerUid', 'memberIds', 'members', 'inviteCode', 'createdAt', 'updatedAt'])
        && after().name is string && after().name.size() > 0 && after().name.size() <= 60
        && after().ownerUid == request.auth.uid
        && after().memberIds == [request.auth.uid]
        && after().members.keys().hasOnly([request.auth.uid])
        && after().members[request.auth.uid].role == 'admin'
        && after().members[request.auth.uid].keys().hasOnly(['name', 'email', 'photoURL', 'role'])
        && sane(after().members[request.auth.uid])
        && after().inviteCode is string && after().inviteCode.size() == 8
        && after().createdAt == request.time
        && after().updatedAt == request.time);

      allow update: if isSuperAdmin() || (signedIn()
        && after().updatedAt == request.time
        && (adminEdit() || selfLeave() || selfJoin()));

      // An admin renames the team, makes a new invite code, changes roles or removes people. The owner stays an
      // admin and a member, and the person acting stays a member.
      function adminEdit() {
        return isAdminOf(before())
          && after().ownerUid == before().ownerUid
          && changedKeys().hasOnly(['name', 'inviteCode', 'memberIds', 'members', 'updatedAt'])
          && after().name is string && after().name.size() > 0 && after().name.size() <= 60
          && after().inviteCode is string && after().inviteCode.size() == 8
          && after().ownerUid in after().memberIds
          && after().members[after().ownerUid].role == 'admin'
          && request.auth.uid in after().memberIds
          && after().memberIds.toSet() == after().members.keys().toSet();
      }

      // Anyone but the owner removes only themselves.
      function selfLeave() {
        return isMemberOf(before()) && request.auth.uid != before().ownerUid
          && changedKeys().hasOnly(['memberIds', 'members', 'updatedAt'])
          && after().memberIds.toSet() == before().memberIds.toSet().difference([request.auth.uid].toSet())
          && after().members.diff(before().members).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in after().members.keys());
      }

      // Someone adds only themselves, as a member, and proves they know the current invite code.
      function selfJoin() {
        return !(request.auth.uid in before().memberIds)
          && changedKeys().hasOnly(['memberIds', 'members', 'updatedAt'])
          && after().memberIds.toSet() == before().memberIds.toSet().union([request.auth.uid].toSet())
          && after().members.diff(before().members).affectedKeys().hasOnly([request.auth.uid])
          && after().members[request.auth.uid].role == 'member'
          && after().members[request.auth.uid].joinCode == before().inviteCode
          && after().members[request.auth.uid].keys().hasOnly(['name', 'email', 'photoURL', 'role', 'joinCode'])
          && sane(after().members[request.auth.uid]);
      }

      // Teams are otherwise never deleted — "nothing is really deleted" — except by a superadmin, who can
      // permanently remove a team from the website's Superadmin Portal.
      allow delete: if isSuperAdmin();

      match /tasks/{taskId} {
        function team() { return get(/databases/$(database)/documents/teams/$(teamId)).data; }
        function inTeam() { return signedIn() && request.auth.uid in team().memberIds; }
        function asAdmin() { return inTeam() && team().members[request.auth.uid].role == 'admin'; }
        function asLead() { return inTeam() && team().members[request.auth.uid].role in ['admin', 'lead']; }
        // assigneeOk: who the task is given to must be a current member (for an edit, the person it already
        // had may stay even after leaving the team, so it can still be tidied up).
        function validTask(t, assigneeOk) {
          return t.title is string && t.title.size() > 0 && t.title.size() <= 200
            && t.notes is string && t.notes.size() <= 4000
            && t.assigneeUid is string && assigneeOk
            && t.status in ['todo', 'doing', 'done']
            && t.priority in ['low', 'medium', 'high']
            && t.dueDate is string && (t.dueDate == '' || t.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
            && t.mustDo is bool
            && t.deleted is bool
            && t.createdBy is string;
        }

        allow read: if isSuperAdmin() || inTeam();

        // Admins and leads give tasks. A superadmin may create a task on any team, bypassing the normal shape
        // checks (used by the website's Universal Raw Entity Editor / direct task tooling).
        allow create: if isSuperAdmin() || (asLead()
          && request.resource.data.keys().hasOnly(['title', 'notes', 'assigneeUid', 'createdBy', 'status', 'priority', 'dueDate', 'mustDo', 'deleted', 'createdAt', 'updatedAt'])
          && validTask(request.resource.data, request.resource.data.assigneeUid in team().memberIds)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.deleted == false
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time);

        // An admin edits any task, a lead the tasks they created, and the person a task is given to only its
        // status. A superadmin edits any task on any team without restriction.
        allow update: if isSuperAdmin() || (inTeam()
          && request.resource.data.updatedAt == request.time
          && (
            ((asAdmin() || (asLead() && resource.data.createdBy == request.auth.uid))
              && request.resource.data.keys().hasOnly(['title', 'notes', 'assigneeUid', 'createdBy', 'status', 'priority', 'dueDate', 'mustDo', 'deleted', 'createdAt', 'updatedAt'])
              && validTask(request.resource.data, request.resource.data.assigneeUid in team().memberIds || request.resource.data.assigneeUid == resource.data.assigneeUid)
              && request.resource.data.createdBy == resource.data.createdBy
              && request.resource.data.createdAt == resource.data.createdAt)
            ||
            (resource.data.assigneeUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
              && request.resource.data.status in ['todo', 'doing', 'done'])
          ));

        // Tasks are never hard-deleted by the app itself (soft-delete only, via the "deleted" flag above) —
        // except by a superadmin.
        allow delete: if isSuperAdmin();
      }

      match /events/{eventId} {
        function team() { return get(/databases/$(database)/documents/teams/$(teamId)).data; }
        function inTeam() { return signedIn() && request.auth.uid in team().memberIds; }
        function asAdmin() { return inTeam() && team().members[request.auth.uid].role == 'admin'; }
        function asLead() { return inTeam() && team().members[request.auth.uid].role in ['admin', 'lead']; }
        function validEvent(e) {
          return e.title is string && e.title.size() > 0 && e.title.size() <= 300
            && e.startDate is string && e.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && e.endDate is string && e.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && e.allDay is bool
            && e.startTime is string && (e.startTime == '' || e.startTime.matches('^[0-2][0-9]:[0-5][0-9]$'))
            && e.endTime is string && (e.endTime == '' || e.endTime.matches('^[0-2][0-9]:[0-5][0-9]$'))
            && e.notes is string && e.notes.size() <= 8000
            && e.deleted is bool
            && e.createdBy is string;
        }

        allow read: if isSuperAdmin() || inTeam();

        // Admins and leads add team events; an admin changes any, a lead the ones they made. A superadmin adds
        // or changes any team event on any team without restriction (used by the website's calendar tab).
        allow create: if isSuperAdmin() || (asLead()
          && request.resource.data.keys().hasOnly(['title', 'startDate', 'endDate', 'allDay', 'startTime', 'endTime', 'notes', 'createdBy', 'deleted', 'createdAt', 'updatedAt'])
          && validEvent(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.deleted == false
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time);

        allow update: if isSuperAdmin() || (
          (asAdmin() || (asLead() && resource.data.createdBy == request.auth.uid))
          && request.resource.data.keys().hasOnly(['title', 'startDate', 'endDate', 'allDay', 'startTime', 'endTime', 'notes', 'createdBy', 'deleted', 'createdAt', 'updatedAt'])
          && validEvent(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time);

        // Events are never hard-deleted by the app itself (soft-delete only) — except by a superadmin.
        allow delete: if isSuperAdmin();
      }
    }

    // ===============================================================
    // Public Release Ledger (vayun-workspace's /admin and /superadmin pages)
    // ===============================================================
    //
    // Collection: releases, Document ID: {releaseId} (e.g. "v1-0-7")
    //   id, version, title, releaseDate: string — release identification
    //   channel: 'stable' | 'beta' | 'preview'
    //   isLatest, isPublished: bool
    //   releaseNotes: list (<= 50 strings, each <= 1000 chars); markdownNotes: string (optional, <= 10000 chars)
    //   platforms: map (windows/macos/linux installer metadata); downloadsCount: number >= 0
    //   createdAt, updatedAt: timestamp or number
    match /releases/{releaseId} {
      function isValidRelease(data) {
        return data.keys().hasAll(['id', 'version', 'title', 'releaseDate', 'channel', 'isLatest', 'isPublished', 'releaseNotes', 'platforms', 'downloadsCount']) &&
          data.keys().hasOnly(['id', 'version', 'title', 'releaseDate', 'channel', 'isLatest', 'isPublished', 'releaseNotes', 'markdownNotes', 'platforms', 'downloadsCount', 'createdAt', 'updatedAt']) &&
          data.id is string && data.id.size() >= 1 && data.id.size() <= 50 &&
          data.version is string && data.version.size() >= 1 && data.version.size() <= 50 &&
          data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
          data.releaseDate is string && data.releaseDate.size() >= 1 && data.releaseDate.size() <= 20 &&
          data.channel in ['stable', 'beta', 'preview'] &&
          data.isLatest is bool &&
          data.isPublished is bool &&
          data.releaseNotes is list && data.releaseNotes.size() <= 50 &&
          (!('markdownNotes' in data) || (data.markdownNotes is string && data.markdownNotes.size() <= 10000)) &&
          data.platforms is map &&
          data.downloadsCount is number && data.downloadsCount >= 0 &&
          (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is number) &&
          (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is number);
      }
      function isDownloadCountIncrement() {
        return resource.data.isPublished == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadsCount']) &&
          request.resource.data.downloadsCount == resource.data.downloadsCount + 1;
      }

      // Public can read published releases. Release Admins and Super Admins can read all releases.
      allow read: if isReleaseAdmin() || resource.data.isPublished == true;
      allow create: if isReleaseAdmin() && isValidRelease(request.resource.data) && request.resource.data.id == releaseId;
      // Releases can be updated by admins, or incremented (+1) by public downloads.
      allow update: if (isReleaseAdmin() && isValidRelease(request.resource.data) && request.resource.data.id == resource.data.id) ||
        isDownloadCountIncrement();
      allow delete: if isReleaseAdmin();
    }

    // ===============================================================
    // Global Superadmin Fallback — Universal Raw Entity Editor
    // ===============================================================
    // Anything not matched above (and every path above, redundantly) is reachable by a superadmin for the
    // website's raw document inspector/patcher. Deny by default for everyone else.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
