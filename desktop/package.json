{
  "name": "pages-desktop",
  "productName": "Vayun",
  "version": "1.0.5",
  "description": "Vayun - local notes, planners and an AI assistant",
  "author": "Mukul Sharma",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:mac:arm64": "electron-builder --mac --arm64",
    "dist:mac:universal": "electron-builder --mac --universal",
    "dist:mac:all": "electron-builder --mac --arm64 --universal --x64",
    "dist:all": "electron-builder -mw"
  },
  "build": {
    "appId": "com.vayun.desktop",
    "productName": "Vayun",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "main.js",
      "preload.js",
      "ai.js",
      "auth.js",
      "auth-logic.js",
      "gcal.js",
      "gcal-logic.js",
      "gcal-client.json",
      "pdf-import.js",
      "notion-import.js",
      "app/**/*",
      "package.json",
      "!**/*.test.js",
      "!**/node_modules/@napi-rs/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "app/brand/vayun-icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "darkModeSupport": true,
      "minimumSystemVersion": "11.0.0"
    },
    "dmg": {
      "title": "Vayun",
      "artifactName": "Vayun-${version}-${arch}.dmg",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": "nsis",
      "icon": "app/brand/vayun-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vayun",
      "artifactName": "Vayun-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.0.12"
  },
  "dependencies": {
    "adm-zip": "0.5.16",
    "firebase": "^13.1.0",
    "pdfjs-dist": "6.4.299"
  }
}
